{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamTracker",
  "version": "0.1.0",
  "identifier": "com.silverwalldiscs.steamtracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SteamTracker",
        "width": 1040,
        "height": 790,
        "minWidth": 680,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/rich-presence-helper/node.exe": "rich-presence-helper/node.exe",
      "resources/rich-presence-helper/index.cjs": "rich-presence-helper/index.cjs",
      "resources/rich-presence-helper/node_modules/": "rich-presence-helper/node_modules/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Spanish",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
